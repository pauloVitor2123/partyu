# URL pública do site, sem barra no final. Na Vercel, se vazio, usa o domínio de produção do projeto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só "true" quando o domínio definitivo (partyu.com.br) estiver configurado. Fora disso o site fica fora do Google.
NEXT_PUBLIC_ALLOW_INDEXING=false

# E-mail de contato exibido no site e na Política de Privacidade.
NEXT_PUBLIC_CONTACT_EMAIL=contato@partyu.com.br

# Supabase (lista de espera). Use a chave SECRETA (sb_secret_...) — nunca exponha com prefixo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
